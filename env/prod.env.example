# Production overrides, loaded AFTER env/netbox.env (compose env_file order).
# The real env/prod.env lives on the persistent data disk and is symlinked/copied
# into place by deploy/bootstrap.sh — NEVER committed.
#
# Also regenerate for prod (in env/netbox.env on the data disk, not here):
#   SECRET_KEY               (must persist across the 30-day redeploys!)
#   API_TOKEN_PEPPER_1       (ditto)
#   REDIS_* passwords
# and remove/ignore DB_* dev values there in favor of these.

# --- Database: RDS ---------------------------------------------------------
DB_HOST=your-rds-instance.xxxxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=netbox
DB_USER=netbox
DB_PASSWORD=CHANGE_ME
# require = TLS without CA verification; verify-full needs sslrootcert via extra.py
DB_SSLMODE=require

# --- Media: S3 (activates STORAGES in configuration/extra.py) --------------
S3_MEDIA_BUCKET=your-netbox-media-bucket
AWS_REGION=us-east-1
# S3_MEDIA_PREFIX=netbox-media

# --- Serving at nova.jtklabs.dev/netbox ------------------------------------
BASE_PATH=netbox/
CSRF_TRUSTED_ORIGINS=https://nova.jtklabs.dev
ALLOWED_HOSTS=nova.jtklabs.dev localhost

# NOTE: BIND_ADDRESS does NOT belong in this file. It controls the published
# port, which Docker Compose substitutes when it parses the compose file — and
# compose does not read env_file entries for that, only the project `.env`.
# Setting it here has no effect and NetBox stays on loopback, unreachable from
# the Apache server. Put it in /mnt/data_disk/netbox-secrets/.env instead.

# --- SSO via Apache + mod_auth_mellon (header auth) -------------------------
# The existing Mellon setup already injects: X-Remote-User, X-User-AD-Username,
# X-User-Email, X-UserFirstName, X-User-LastName, X-User-FullName, X-User-Groups.
# Header -> WSGI name: dashes become underscores with an HTTP_ prefix.
REMOTE_AUTH_ENABLED=true
REMOTE_AUTH_HEADER=HTTP_X_REMOTE_USER
REMOTE_AUTH_AUTO_CREATE_USER=true
REMOTE_AUTH_USER_EMAIL=HTTP_X_USER_EMAIL
REMOTE_AUTH_USER_FIRST_NAME=HTTP_X_USERFIRSTNAME
REMOTE_AUTH_USER_LAST_NAME=HTTP_X_USER_LASTNAME
REMOTE_AUTH_GROUP_SYNC_ENABLED=true
REMOTE_AUTH_GROUP_HEADER=HTTP_X_USER_GROUPS
# VERIFY on first login: the delimiter Mellon uses inside X-User-Groups.
# NetBox default is "|"; adjust if yours joins with ";" or ",".
REMOTE_AUTH_GROUP_SEPARATOR=|
# AD group whose members get NetBox superuser (set to your admin group):
REMOTE_AUTH_SUPERUSER_GROUPS=netbox-admins

# --- Dev-only knobs forced off ---------------------------------------------
SKIP_SUPERUSER=true
CORS_ORIGIN_ALLOW_ALL=False

# --- Discovery (only if the orb-agent runs on this host) --------------------
# DISCOVERY_* and the Diode secrets block are appended to the data-disk .env
# by bootstrap; see deploy/bootstrap.sh.
