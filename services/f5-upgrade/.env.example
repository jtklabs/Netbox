# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
F5_API_TOKEN=
# Default UCS encryption passphrase; do not pass secrets in API job payloads.
F5_UCS_PASSPHRASE=
# Optional SSH password instead of a key, referenced by devices.json:
# F5_LAB_PASSWORD=
F5_DATA_DIR=./data
F5_IMAGE_ROOT=./images
F5_BACKUP_ROOT=./backups
F5_DEVICES_FILE=./config/devices.json
F5_KNOWN_HOSTS=./config/known_hosts
F5_BIND_ADDRESS=127.0.0.1
F5_PORT=8080
# Optional SNMP v3 walks. Copy snmp-profiles.example.json to config/snmp-profiles.json.
# Docker path (use ./config/snmp-profiles.json when running directly on the host):
# F5_SNMP_PROFILES_FILE=/config/snmp-profiles.json
# F5_SNMP_AUTH_PASSWORD=
# F5_SNMP_PRIV_PASSWORD=
# Encrypted profile storage. Generate once: f5-upgrade init-key config/credentials.key
# Docker paths; use ./config/... for direct host execution.
F5_CREDENTIAL_KEY_FILE=/config/credentials.key
F5_HTTP_TARGETS_FILE=/config/http-targets.json
