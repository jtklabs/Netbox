F5_API_TOKEN=
F5_UCS_PASSPHRASE=
F5_DATA_DIR=/var/lib/f5-upgrade
F5_BACKUP_ROOT=/var/backups/f5-upgrade
F5_IMAGE_ROOT=/srv/f5-images
F5_DEVICES_FILE=/etc/f5-upgrade/devices.json
F5_KNOWN_HOSTS=/etc/f5-upgrade/known_hosts
# Optional SNMP v3 walks:
# F5_SNMP_PROFILES_FILE=/etc/f5-upgrade/snmp-profiles.json
# F5_SNMP_AUTH_PASSWORD=
# F5_SNMP_PRIV_PASSWORD=
F5_CREDENTIAL_KEY_FILE=/etc/f5-upgrade/credentials.key
F5_HTTP_TARGETS_FILE=/etc/f5-upgrade/http-targets.json
