PATH_MONITOR_USERNAME=jason
# Fill these in before starting; the service requires all three credentials.
# Single quotes preserve literal $ and # characters in Compose dotenv values.
PATH_MONITOR_PASSWORD=''
PATH_MONITOR_API_TOKEN=''
# true for HTTPS; false for local HTTP testing.
PATH_MONITOR_COOKIE_SECURE=true
PATH_MONITOR_BIND_ADDRESS=127.0.0.1
PATH_MONITOR_PUBLIC_PORT=8091
