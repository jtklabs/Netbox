# Dedicated PostgreSQL DATABASE and role, separate from NetBox.
# URL-encode special characters in the password. Use verify-full with a trusted
# CA in production; this example assumes PostgreSQL on the same private host.
DISCOVERY_DATABASE_URL=postgresql+psycopg://discovery:CHANGE_ME@host.docker.internal:5432/discovery
DISCOVERY_BIND_ADDRESS=127.0.0.1
DISCOVERY_PUBLIC_PORT=8092
DISCOVERY_STALE_SECONDS=900
DISCOVERY_RETENTION_DAYS=90
