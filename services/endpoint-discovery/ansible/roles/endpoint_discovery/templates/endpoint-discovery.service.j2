[Unit]
Description=Endpoint discovery {{ discovery_mode }}
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ discovery_service_dir }}
ExecStart=/usr/bin/docker compose -f {{ discovery_compose_file }} up -d --remove-orphans
ExecStop=/usr/bin/docker compose -f {{ discovery_compose_file }} stop
TimeoutStartSec=180
TimeoutStopSec=90

[Install]
WantedBy=multi-user.target
