[Unit]
Description=NetOps Executor worker %i
After=network-online.target
Wants=network-online.target

[Service]
User=netopsexecutor
Group=netopsexecutor
WorkingDirectory=/opt/netops-executor
EnvironmentFile=/etc/netops-executor/service.env
ExecStart=/opt/netops-executor/.venv/bin/netops-executor worker
Restart=on-failure
TimeoutStopSec=2h
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/netops-executor /var/backups/netops-executor /srv/f5-images

[Install]
WantedBy=multi-user.target
