NETOPS_API_TOKEN=
NETOPS_UCS_PASSPHRASE=
NETOPS_DATA_DIR=/var/lib/netops-executor
NETOPS_BACKUP_ROOT=/var/backups/netops-executor
NETOPS_IMAGE_ROOT=/srv/f5-images
NETOPS_DEVICES_FILE=/etc/netops-executor/devices.json
NETOPS_KNOWN_HOSTS=/etc/netops-executor/known_hosts
# Optional SNMP v3 walks:
# NETOPS_SNMP_PROFILES_FILE=/etc/netops-executor/snmp-profiles.json
# NETOPS_SNMP_AUTH_PASSWORD=
# NETOPS_SNMP_PRIV_PASSWORD=
NETOPS_CREDENTIAL_KEY_FILE=/etc/netops-executor/credentials.key
NETOPS_HTTP_TARGETS_FILE=/etc/netops-executor/http-targets.json
