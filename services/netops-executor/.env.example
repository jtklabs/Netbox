# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
NETOPS_API_TOKEN=
# Default UCS encryption passphrase; do not pass secrets in API job payloads.
NETOPS_UCS_PASSPHRASE=
# Optional SSH password instead of a key, referenced by devices.json:
# NETOPS_LAB_PASSWORD=
NETOPS_DATA_DIR=./data
NETOPS_IMAGE_ROOT=./images
NETOPS_BACKUP_ROOT=./backups
NETOPS_DEVICES_FILE=./config/devices.json
NETOPS_KNOWN_HOSTS=./config/known_hosts
# Device trust: "pin" accepts an SSH host key missing from known_hosts on first use, then only it.
# NETOPS_SSH_HOST_KEYS=pin
# Firewall management certificates are pinned on first use unless a CA bundle is set here.
# NETOPS_FIREWALL_CA_FILE=
NETOPS_BIND_ADDRESS=127.0.0.1
NETOPS_PORT=8080
# POST to the central application when a job finishes or needs review (HTTPS), sent with
# Authorization: Bearer <NETOPS_WEBHOOK_TOKEN>. The optional secret (32+ characters) also adds
# an X-NetOps-Signature HMAC of the body.
# NETOPS_WEBHOOK_URL=https://central.example/netops/webhook
# NETOPS_WEBHOOK_TOKEN=
# NETOPS_WEBHOOK_SECRET=
# NETOPS_WEBHOOK_CA_FILE=/config/webhook-ca.pem
# NETOPS_WEBHOOK_MAX_ROWS=10000
# Workers per pool. Each claims from its own queue first, then the other pool's, then scheduled jobs.
NETOPS_PRIORITY_WORKERS=2
NETOPS_UPGRADE_WORKERS=1
# Optional SNMP v3 walks. Copy snmp-profiles.example.json to config/snmp-profiles.json.
# Docker path (use ./config/snmp-profiles.json when running directly on the host):
# NETOPS_SNMP_PROFILES_FILE=/config/snmp-profiles.json
# NETOPS_SNMP_AUTH_PASSWORD=
# NETOPS_SNMP_PRIV_PASSWORD=
# Encrypted profile storage. Generate once: netops-executor init-key config/credentials.key
# Docker paths; use ./config/... for direct host execution.
NETOPS_CREDENTIAL_KEY_FILE=/config/credentials.key
NETOPS_HTTP_TARGETS_FILE=/config/http-targets.json

# Keep an existing Compose project name when upgrading to retain its volumes.
# NETOPS_COMPOSE_PROJECT=netops-executor
