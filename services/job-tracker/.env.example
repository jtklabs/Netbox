# Include the deployment subpath, if any. Do not include /api/.
NETBOX_URL=https://netbox.example.com/netbox
NETBOX_TOKEN=replace-with-read-only-api-token
NETBOX_AUTH_SCHEME=Token
TRACKER_POLL_SECONDS=5
TRACKER_RECENT_BATCHES=8
# Set to the server's internal IP or 0.0.0.0 for direct LAN access.
TRACKER_BIND_ADDRESS=127.0.0.1
TRACKER_PUBLIC_PORT=8090
