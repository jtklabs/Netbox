# Real env files carry secrets and are generated locally (scripts/init-dev-env.sh);
# only the .example templates are committed.
.env
env/*.env
# Dev TLS material for the reverse proxy
compose/dev-tls/
# F5 image push tool — real creds/inventory stay local, only .example is committed
scripts/f5-image-push/config.ini
scripts/f5-image-push/devices.csv
scripts/f5-image-push/push-report.csv
scripts/f5-image-push/disk-report.csv
scripts/f5-image-push/ucs-report.csv
scripts/f5-image-push/ucs-backups/
scripts/f5-image-push/*.iso
scripts/f5-image-push/*.ucs
# F5 tools (scripts/f5) — credentials and inventory stay local
scripts/f5/.env
scripts/f5/devices.csv
# Config backups: a UCS holds every SSL private key and the user database, and
# an SCF holds the configuration and password hashes. These never get committed.
scripts/f5/backups/
scripts/f5/*.ucs
scripts/f5/*.scf
*.pyc
__pycache__/
.DS_Store
# SNMP inventory scanner — real config, credentials and inventory stay local
scripts/snmp-inventory/snmp-inventory.conf
scripts/snmp-inventory/snmp-credentials.conf
scripts/snmp-inventory/devices.csv
scripts/snmp-inventory/*.log
