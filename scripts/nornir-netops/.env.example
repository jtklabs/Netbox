# Copy to .env (gitignored) and fill in. Real environment variables win over
# this file, so `NET_PASS=... ./configure.py ...` still overrides it.

# --- login ---------------------------------------------------------------
NET_USER=netauto
NET_PASS=
# Only needed when the login does not land in privileged mode:
NET_ENABLE=
# Or authenticate with a key instead of a password:
#NET_KEY_FILE=~/.ssh/id_ed25519
#NET_PORT=22

# --- or pull the login from AWS Secrets Manager --------------------------
# Set the secret name and the credentials above can be left empty. Auth uses
# the ambient IAM identity (instance profile, task role, SSO session).
#NET_AWS_SECRET=prod/network/netauto
#NET_AWS_REGION=us-east-1
# Only if the JSON keys are not username/password/enable_secret:
#NET_AWS_USERNAME_KEY=username
#NET_AWS_PASSWORD_KEY=password
#NET_AWS_ENABLE_KEY=enable_secret

# --- local account passwords (the `users` feature) -----------------------
# One variable per managed account: NETOPS_PW_<ACCOUNT>, uppercased with any
# non-alphanumeric character replaced by an underscore.
#NETOPS_PW_ADMIN=
#NETOPS_PW_NETAUTO=
# Or hold them all in one AWS secret, as {"admin": "...", "netauto": "..."}:
#NETOPS_PW_SECRET=prod/network/local-users

# --- SNMPv3 passphrases (the `snmp` feature) -----------------------------
# Two per managed user: NETOPS_SNMP_AUTH_<USER> and NETOPS_SNMP_PRIV_<USER>.
#NETOPS_SNMP_AUTH_NMSUSER=
#NETOPS_SNMP_PRIV_NMSUSER=
# Or hold them in one AWS secret, as {"nmsuser": {"auth": "...", "priv": "..."}}:
#NETOPS_SNMP_SECRET=prod/network/snmpv3

# --- inventory -----------------------------------------------------------
NETOPS_CSV=inventory/hosts.csv
# The desired-state file (--no-standards ignores it):
#NETOPS_STANDARDS=standards.yaml

# --- ServiceNow (--open-change / --change) -------------------------------
#SNOW_INSTANCE=acme
# Either basic auth...
#SNOW_USER=
#SNOW_PASS=
# ...or an OAuth client_credentials application:
#SNOW_CLIENT_ID=
#SNOW_CLIENT_SECRET=
# ...or hold any of the above in one AWS secret:
#SNOW_SECRET=prod/network/servicenow

# --- run behaviour -------------------------------------------------------
# Where full errors and tracebacks are written (--no-log-file disables):
#NETOPS_LOG_FILE=netops-debug.log
# Seconds to wait for a TCP connection before giving up on a device:
#NET_CONN_TIMEOUT=10
