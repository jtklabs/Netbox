# Copy to .env (gitignored) and fill in. Real environment variables win over
# this file, so `NET_PASS=... ./configure.py ...` still overrides it.

# --- login ---------------------------------------------------------------
NET_USER=netauto
NET_PASS=
# Only needed when the login does not land in privileged mode:
NET_ENABLE=
# Or authenticate with a key instead of a password:
#NET_KEY_FILE=~/.ssh/id_ed25519
#NET_PORT=22

# --- or pull the login from AWS Secrets Manager --------------------------
# Set the secret name and the credentials above can be left empty. Auth uses
# the ambient IAM identity (instance profile, task role, SSO session).
#NET_AWS_SECRET=prod/network/netauto
#NET_AWS_REGION=us-east-1
# Only if the JSON keys are not username/password/enable_secret:
#NET_AWS_USERNAME_KEY=username
#NET_AWS_PASSWORD_KEY=password
#NET_AWS_ENABLE_KEY=enable_secret

# --- local account passwords (the `users` feature) -----------------------
# One variable per managed account: NETOPS_PW_<ACCOUNT>, uppercased with any
# non-alphanumeric character replaced by an underscore.
#NETOPS_PW_ADMIN=
#NETOPS_PW_NETAUTO=
# Or hold them all in one AWS secret, as {"admin": "...", "netauto": "..."}:
#NETOPS_PW_SECRET=prod/network/local-users

# --- SNMPv3 passphrases (the `snmp` feature) -----------------------------
# Two per managed user: NETOPS_SNMP_AUTH_<USER> and NETOPS_SNMP_PRIV_<USER>.
#NETOPS_SNMP_AUTH_NMSUSER=
#NETOPS_SNMP_PRIV_NMSUSER=
# Or hold them in one AWS secret, as {"nmsuser": {"auth": "...", "priv": "..."}}:
#NETOPS_SNMP_SECRET=prod/network/snmpv3

# --- NetBox inventory (--netbox) -----------------------------------------
# Install requests, then uncomment URL and token below in your .env.
# These are API credentials; NET_USER/NET_PASS above are the device SSH login.
#NETBOX_URL=https://netbox.example.com
#NETBOX_TOKEN=
# ...or hold both in one AWS secret, as {"url": "...", "token": "..."}:
#NETBOX_SECRET=prod/network/netbox

# Default inventory source when --csv, --ip, or --netbox is not specified:
#NETOPS_INVENTORY=netbox
# Space-separated API filters; repeated keys are supported. CLI filters replace this list.
#NETBOX_FILTERS="platform=f5-tmos site=atl"

# --- Syslog policy and source (Cisco, Arista and F5) -----------------------
# audit, add, manage, or netbox (resolve each device's policy tag independently).
#NETOPS_SYSLOG_POLICY=netbox
# Cisco/Arista interface tag; each device may have a different tagged interface.
#NETBOX_SYSLOG_SOURCE_TAG=syslog-source

# --- HTTPS trust (NetBox and F5) ------------------------------------------
# Python 3.10+: truststore uses system CAs automatically; no bundle setting needed.
# Python 3.9: use the bundle below after installing your internal CA.
# These paths can also explicitly supply an additional CA bundle on newer Python.
# Uncomment only the path for the OS running this script (also works in a venv).
# Ubuntu 24.04:
#REQUESTS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt
# RHEL 9:
#REQUESTS_CA_BUNDLE=/etc/pki/tls/certs/ca-bundle.crt

# --- F5 logging (configure.py waf / configure.py syslog) ------------------
# Uses the device login above, including NET_AWS_SECRET and its key mappings.
# With NETOPS_INVENTORY=netbox, a plain ./configure.py waf reads NetBox.
# Defaults below are optional; --apply stays an explicit CLI flag.
# Legacy policy fallback when NETOPS_SYSLOG_POLICY is unset:
#NETOPS_F5_POLICY=netbox
#NETOPS_F5_PORT=443
#NETOPS_F5_TIMEOUT=30
#NETOPS_F5_VERIFY_TLS=true
#NETOPS_F5_LOGIN_PROVIDER=tmos
#NETBOX_CHECKED_FIELD=syslog_last_checked

# --- inventory -----------------------------------------------------------
NETOPS_CSV=inventory/hosts.csv
# The desired-state file (--no-standards ignores it):
#NETOPS_STANDARDS=standards.yaml

# --- NTP authentication key (the `ntp` feature) --------------------------
# One per key id: NETOPS_NTP_KEY_<id>.
#NETOPS_NTP_KEY_1=
# Or hold them in one AWS secret, as {"1": "<material>"}:
#NETOPS_NTP_SECRET=prod/network/ntp

# --- ServiceNow (--open-change / --change) -------------------------------
#SNOW_INSTANCE=acme
# Either basic auth...
#SNOW_USER=
#SNOW_PASS=
# ...or an OAuth client_credentials application:
#SNOW_CLIENT_ID=
#SNOW_CLIENT_SECRET=
# ...or hold any of the above in one AWS secret:
#SNOW_SECRET=prod/network/servicenow

# --- run behaviour -------------------------------------------------------
# Where detected platforms are remembered, and for how long:
#NETOPS_PLATFORM_CACHE=.platform-cache.json
#NETOPS_PLATFORM_CACHE_TTL=24
# Where full errors and tracebacks are written (--no-log-file disables):
#NETOPS_LOG_FILE=netops-debug.log
# Seconds to wait for a TCP connection before giving up on a device:
#NET_CONN_TIMEOUT=10
