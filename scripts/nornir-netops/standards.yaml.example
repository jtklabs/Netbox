# Copy to standards.yaml and edit. The real file is gitignored -- this example
# is what ships, so it never overwrites yours.
#
# Our network standards, in one platform-neutral file.
#
# These values are the same for every device and every platform -- the same NTP
# sources, the same syslog collectors, the same SNMP pollers -- so they are
# written once, generically, and each template maps them onto that platform's
# own configuration syntax.
#
# Your standards.yaml is worth keeping in version control somewhere -- the
# standard itself belongs under change control. There are no credentials here. Device logins live in .env or AWS
# Secrets Manager, and SNMPv3 auth/priv passwords are resolved the same way
# (see the snmp.users section below).
#
# Command line flags override anything here, so a one-off run never needs the
# file edited. Replace the placeholder addresses with the real ones.

# --------------------------------------------------------------------------
# NTP  ->  configure.py ntp
# --------------------------------------------------------------------------
ntp:
  servers:
    - 10.50.0.10         # primary
    - 10.50.0.11         # secondary
  # prefer: 10.50.0.10
  # vrf: MGMT
  # source: Loopback0

# --------------------------------------------------------------------------
# Syslog  ->  configure.py syslog
# A bare address means the default port, 514; use the host/port form for
# anything else.
# --------------------------------------------------------------------------
syslog:
  destinations:
    - 10.1.1.50          # primary collector, port 514
    - host: 10.1.1.51    # secondary collector on a non-default port
      port: 1514
  severity: informational
  # source: Loopback0
  # vrf: MGMT

# --------------------------------------------------------------------------
# SNMP  ->  configure.py snmp
#
# v3 only. `communities: []` is a statement, not an omission: it means no v2c
# community may exist, and any found on a device is removed.
#
# SNMPv3 auth/priv passwords are never written here. Each user's passwords come
# from the environment or AWS Secrets Manager, the same way local account
# passwords do -- see the README.
# --------------------------------------------------------------------------
snmp:
  # Networks allowed to poll at all. Stated once here and referenced by the
  # ACL below, so there is one place to add a new poller.
  allow:
    - 10.1.1.0/24        # NMS / poller subnet
    - 10.2.0.0/16        # monitoring VLANs

  # The default ACL, applied to any group or user that does not name its own.
  acl: SNMP-POLLERS

  communities: []        # v2c: none permitted, remove any found

  location: "ATL DC1 - row 4"
  contact: "netops@example.com"

  views:
    - name: NMS-VIEW
      oid: iso
      action: included

  # One group per account, so the ACL that says where an account may be used
  # lives on the group. A group is written into the running config, so that
  # binding is readable and drift on it is detected; a per-user `acl:` is
  # accepted but IOS never reports it back, so it can never be verified.
  groups:
    - name: NMS-RO
      security: priv     # noauth | auth | priv
      read: NMS-VIEW
      acl: SNMP-NMS

    - name: MON-RO
      security: priv
      read: NMS-VIEW
      acl: SNMP-MONITORING

  # Each account sits in its own group and inherits that group's ACL.
  #
  # A passphrase cannot be read back from a device, so changing one here does
  # not show up as drift. Push it with `configure.py snmp --rewrite-users`.
  users:
    - name: nmsuser
      group: NMS-RO
      auth: sha
      priv: aes 128

    - name: monuser
      group: MON-RO
      auth: sha
      priv: aes 128

  hosts:
    - host: 10.1.1.50
      user: nmsuser
      security: priv

  packetsize: 1300       # cisco only; EOS has no equivalent

# --------------------------------------------------------------------------
# Banner  ->  configure.py banner
# The text itself lives in templates/<platform>/banner.j2 so it can differ per
# platform where it has to; this only says which banners are managed.
# --------------------------------------------------------------------------
banner:
  motd: true
  login: false

# --------------------------------------------------------------------------
# ACLs  ->  configure.py acl
# Entries are applied in the order written -- order is the whole meaning of an
# ACL, so a device whose entries are in a different order has drifted.
#
# `permit: snmp.allow` points at the networks above rather than repeating them.
#
# `rebuild: true` says this ACL may be deleted and rewritten to correct it.
# Correcting the order is not possible any other way, and for the few
# milliseconds between the two commands the ACL does not exist. That is fine
# for a poller list -- it costs a missed poll -- and it is emphatically not
# fine for a VTY or edge ACL. So it is per-ACL, and off unless stated. An ACL
# that is simply missing is created either way; there is nothing to delete.
# --------------------------------------------------------------------------
acls:
  - name: SNMP-POLLERS   # the default: everything allowed to poll
    type: standard
    permit: snmp.allow
    deny_log: true       # trailing `deny any log`, so denied polls are visible
    rebuild: true        # a missed poll is an acceptable cost here

  - name: SNMP-NMS       # the NMS group, usable only from the NMS itself
    type: standard
    permit:
      - 10.1.1.50/32
    deny_log: true
    rebuild: true

  - name: SNMP-MONITORING
    type: standard
    permit:
      - 10.2.5.0/24
    deny_log: true
    rebuild: true

# --------------------------------------------------------------------------
# Local accounts  ->  configure.py users
# Names only. Passwords come from $NETOPS_PW_<ACCOUNT> or --password-secret.
# --------------------------------------------------------------------------
local_accounts:
  names:
    - admin
    - netauto
  privilege: 15
  # role: network-admin  # EOS

# --------------------------------------------------------------------------
# ServiceNow  ->  configure.py <feature> --open-change / --change CHG0012345
#
# --open-change raises a Normal change from a dry run, with the plan and the
# report attached, and stops. Approve it as usual, then --change implements it
# and closes it. The tool never approves anything: a change that has not
# reached Scheduled or Implement is refused before a device is touched.
#
# Credentials are NOT here -- $SNOW_USER/$SNOW_PASS, $SNOW_CLIENT_ID/
# $SNOW_CLIENT_SECRET, or --snow-secret for AWS Secrets Manager.
#
# Anything other than `states`, `instance` and `verify_tls` is passed straight
# through as a field on the change record.
# --------------------------------------------------------------------------
#change:
#  instance: acme                 # or the full https:// URL
#  assignment_group: Network Engineering
#  category: Network
#  risk: "3"                      # Moderate
#  impact: "3"                    # Low
#
#  # The out-of-the-box Normal change model. Instances customise this
#  # constantly -- check sys_choice for change_request.state on yours and
#  # override any that differ.
#  states:
#    new: "-5"
#    assess: "-4"
#    authorize: "-3"
#    scheduled: "-2"
#    implement: "-1"
#    review: "0"
#    closed: "3"
