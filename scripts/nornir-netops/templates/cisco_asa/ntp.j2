{#- ASA NTP: source is a nameif label; no VRF or iburst options. -#}
{% for entry in remove if entry.data.get('before_add') %}
no {{ entry.line }}
{% endfor %}
{% for key in add %}
{% set item = entries[key] %}
{% if item.kind == 'key' %}
ntp authentication-key {{ item.id }} {{ item.type }} {{ item.material }}
{% elif item.kind == 'trusted-key' %}
ntp trusted-key {{ item.id }}
{% elif item.kind == 'authenticate' %}
ntp authenticate
{% else %}
ntp server {{ item.host }}{% if item.key %} key {{ item.key }}{% endif %}{% if item.get("source", source) %} source {{ item.get("source", source) }}{% endif %}{% if prefer and item.host == prefer %} prefer{% endif %}
{% endif %}
{% endfor %}
{#- Remove obsolete endpoints after adding their replacements. -#}
{% for entry in remove if not entry.data.get('before_add') %}
no {{ entry.line }}
{% endfor %}
