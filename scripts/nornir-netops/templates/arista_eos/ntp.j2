{#-
  Arista EOS -- NTP servers.

  Syntax: ntp server [vrf NAME] <host> [prefer] [iburst] [source INTERFACE]

  Same variables as the IOS template; `iburst` is honoured here and defaults to
  on (--no-iburst turns it off).
-#}
{% for server in add %}
ntp server {% if vrf %}vrf {{ vrf }} {% endif %}{{ server }}{% if prefer and server == prefer %} prefer{% endif %}{% if iburst %} iburst{% endif %}{% if source %} source {{ source }}{% endif %}
{% endfor %}
{% for entry in remove %}
no {{ entry.line }}
{% endfor %}
