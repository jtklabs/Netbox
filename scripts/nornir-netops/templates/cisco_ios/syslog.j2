{#-
  Cisco IOS / IOS-XE -- syslog.

    logging host [vrf NAME] <addr> [transport udp port <port>]
    logging trap <severity>
    logging source-interface <interface>
    logging origin-id {hostname | ip | ipv6 | string <text>}

  Available variables:
    add      list[str]    keys to configure; index into `entries`
    remove   list[Entry]  collectors to negate
    entries  {key: {kind, host, port, severity, source, arguments}}
    vrf      str|None
-#}
{% for key in add %}
{% set item = entries[key] %}
{% if item.kind == 'host' %}
logging host {% if vrf %}vrf {{ vrf }} {% endif %}{{ item.host }}{% if item.port != 514 %} transport udp port {{ item.port }}{% endif %}
{% elif item.kind == 'trap' %}
logging trap {{ item.severity }}
{% elif item.kind == 'source' %}
logging source-interface {{ item.source }}
{% elif item.kind == 'origin' %}
logging origin-id {{ item.arguments }}
{% endif %}
{% endfor %}
{% for entry in remove %}
no {{ entry.line }}
{% endfor %}
