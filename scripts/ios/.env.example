# Copy to .env and fill in. .env is gitignored — never commit it.
#   cp .env.example .env && chmod 600 .env
#
# Anything already exported in the real environment wins over this file, so a
# CI job or a vault wrapper can supply the passwords without writing them to
# disk. Unquoted values run to the end of the line (no inline comments), so a
# password containing '#' needs no quoting.

# --- NetBox: where the standards live and where results are recorded --------
# Include the BASE_PATH if your NetBox is served under one; /api is appended.
NETBOX_URL=https://netbox.example.com/netbox
# Needs view on config standards, and add + change on config compliance.
NETBOX_TOKEN=
#NETBOX_VERIFY_SSL=true
#NETBOX_TIMEOUT=30

# --- The switches -----------------------------------------------------------
# Account used for SSH. Reading `show running-config` needs privilege 15 on
# most estates; --update and --enforce certainly do.
IOS_USERNAME=netops
IOS_PASSWORD=

# Only needed where the login account does not land in privileged exec. Leave
# empty otherwise — an empty value means "do not send enable at all", which is
# right for a privilege-15 account.
#IOS_ENABLE_SECRET=

#IOS_PORT=22
#IOS_TIMEOUT=30
# How many devices to work on at once.
#IOS_WORKERS=5
# netmiko platform. cisco_ios covers classic IOS and IOS-XE.
#IOS_DEVICE_TYPE=cisco_ios

# --- Secrets for remediation ------------------------------------------------
# A standard that says "these local accounts should exist" cannot hold their
# passwords in NetBox, so the password is supplied here, at the moment of the
# write. Without one, the addition is refused and reported — never sent
# half-rendered.
#
# Used for every account a standard adds:
#IOS_ACCOUNT_SECRET=
# ...and per-account, which beats the above. IOS_SECRET_<ACCOUNT>, uppercased:
#IOS_SECRET_NETOPS=
#IOS_SECRET_BACKUPADM=
