# SSH account needs root privileges: Bash login or TMSH with run /util bash access.
F5_USERNAME=root
F5_PASSWORD='replace-me'
# Optional private key instead of a password; paths are relative to this .env.
F5_SSH_KEY=
F5_SSH_KEY_PASSPHRASE=
# Accept previously unknown host keys without prompting (default).
# Use strict to require a matching entry before connecting.
F5_HOST_KEY_POLICY=accept-new
# Optional existing keys, checked when present; defaults to ~/.ssh/known_hosts.
# A missing file is allowed in accept-new mode. No file is written by the job.
F5_KNOWN_HOSTS=
F5_CONNECT_TIMEOUT=15
# Apply uses at least 900 seconds to allow bounded recovery and rollback.
F5_COMMAND_TIMEOUT=900
# Maximum simultaneous device jobs (1-32); --workers overrides this.
F5_WORKERS=1
# SSH handshakes/authentication at once (1-32); device work remains parallel.
F5_SSH_LOGIN_WORKERS=1

# HTTPS receiver for a generic JSON POST after each device finishes.
WEBHOOK_URL=https://example.com/webhooks/f5-mitigation
# Shared receiver secret. Sent as Authorization: Bearer <value> when nonempty.
WEBHOOK_BEARER_TOKEN=
# Optional private CA bundle; TLS verification is always enabled.
WEBHOOK_CA_BUNDLE=
WEBHOOK_TIMEOUT=15
WEBHOOK_ATTEMPTS=3
