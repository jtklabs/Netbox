# Copy to snmp-credentials.conf, fill in, and chmod 600.
# snmp-credentials.conf is gitignored — never commit real passphrases.
#
# SNMPv3 only. v2c is not supported: a community string is sent in clear text,
# and these credentials cross the production network on every scan.
#
# Define one section per credential set. They are tried IN FILE ORDER and the
# first one a device accepts is used, so put the set that covers most of the
# fleet first — every set tried before it costs a round trip.
#
# Passphrases are never passed on the command line. Each set is written to a
# private snmp.conf in a 0600 temp file and net-snmp is pointed at it, so the
# passphrases never appear in `ps` output.
#
# auth_protocol:  MD5 | SHA | SHA-224 | SHA-256 | SHA-384 | SHA-512
# priv_protocol:  DES | AES | AES-192 | AES-256          (AES means AES-128)
# security_level: derived from which passphrases you set —
#                 both -> authPriv, auth only -> authNoPriv, neither ->
#                 noAuthNoPriv. Set it explicitly only to override that.

[credential:primary]
security_name = netops
auth_protocol = SHA-256
auth_passphrase = CHANGE-ME-auth
priv_protocol = AES
priv_passphrase = CHANGE-ME-priv

# A second set for older gear that never got the new user, or for a vendor
# whose firmware predates SHA-256.
[credential:legacy-sha1]
security_name = netops
auth_protocol = SHA
auth_passphrase = CHANGE-ME-old-auth
priv_protocol = DES
priv_passphrase = CHANGE-ME-old-priv

# Some appliances are commissioned auth-only. Omit priv_passphrase and the
# security level becomes authNoPriv on its own.
#[credential:auth-only]
#security_name = monitor
#auth_protocol = SHA
#auth_passphrase = CHANGE-ME

# A device that needs a non-default SNMP context (some VRF-aware platforms):
#[credential:context-mgmt]
#security_name = netops
#auth_protocol = SHA-256
#auth_passphrase = CHANGE-ME
#priv_protocol = AES
#priv_passphrase = CHANGE-ME
#context = management
