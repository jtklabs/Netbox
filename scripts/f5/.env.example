# Copy to .env and fill in. .env is gitignored — never commit it.
#   cp .env.example .env && chmod 600 .env
#
# Anything already exported in the real environment wins over this file, so a
# CI job or a vault wrapper can supply F5_PASSWORD without writing it to disk.
# Unquoted values run to the end of the line (no inline comments), so a
# password containing '#' needs no quoting.

# Account used for iControl REST on the units. Modifying system SNMP config
# needs the Administrator role — lesser roles get a 403 on the write. Pulling an
# SCF additionally needs that account to have an advanced shell.
F5_USERNAME=admin
F5_PASSWORD=changeme

# Set this and f5_backup.py has the units encrypt their UCS archives with it.
# Leave it empty and the archives are plain — they hold every SSL private key
# and the user database, so the output directory is then the only thing
# protecting them. Whatever you set here is needed to restore, so store it
# somewhere the backups are not.
#F5_UCS_PASSPHRASE=

# Auth source for the login token. "tmos" covers local accounts and BIG-IP
# remote auth (TACACS+/RADIUS/LDAP) — leave it unless you know otherwise.
#F5_LOGIN_PROVIDER=tmos

# Management HTTPS port, applied to every unit.
#F5_PORT=443

# Set true once the management interfaces have certs your machine trusts.
#F5_VERIFY_SSL=false

# Per-request HTTP timeout in seconds.
#F5_TIMEOUT=60

# How many units to work on at the same time.
#F5_WORKERS=5
