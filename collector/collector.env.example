# Per-collector settings. Copy to collector.env — NEVER commit the real file.
#
# Get the three DIODE_* values by running this on the central server:
#   ./scripts/new-collector.sh <collector-name>

COLLECTOR_NAME=site-branch-a
DIODE_CLIENT_ID=
DIODE_CLIENT_SECRET=
# The central Diode endpoint as reachable from THIS box.
#   over a VPN/WireGuard tunnel:  grpc://10.90.0.1:8090/diode
#   over public TLS:              grpcs://diode.example.com:8443/diode
DIODE_TARGET=grpc://10.90.0.1:8090/diode

# Path to a CA bundle if the Diode endpoint uses a private CA (must be a path
# inside the container, i.e. under /opt/orb/).
# DIODE_CERT_FILE=/opt/orb/ca.pem

# Device credentials used by policies.yaml
SNMP_USER=
SNMP_AUTH_PASS=
SNMP_PRIV_PASS=
DEVICE_USER=
DEVICE_PASS=

# Pin the agent version to match the fleet.
ORB_AGENT_TAG=2.11.0

# Set to install custom worker packages listed in that file (see worker-example/):
# INSTALL_WORKERS_PATH=/opt/orb/workers.txt
