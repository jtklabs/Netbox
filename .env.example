# Copy to .env and adjust (scripts/init-dev-env.sh does this for you). Dev with discovery:
COMPOSE_FILE=docker-compose.yml:compose/dev.yml:compose/discovery.yml
# Dev core-only (no Diode/orb-agent):
# COMPOSE_FILE=docker-compose.yml:compose/dev.yml
# Prod (Gate 4+):
# COMPOSE_FILE=docker-compose.yml:compose/prod.yml
VERSION=v4.6.7-5.0.2

# Interface the dev stack binds to. Loopback by default, so a laptop is not
# exposed. On a shared dev SERVER set this to the host's LAN address (preferred)
# or 0.0.0.0, and set CSRF_TRUSTED_ORIGINS below to match how you reach it.
BIND_ADDRESS=127.0.0.1

# Required as soon as NetBox is reached by anything other than localhost —
# Django rejects the login POST as a CSRF failure otherwise. Space-separated,
# scheme included:  CSRF_TRUSTED_ORIGINS=https://netbox-dev.example.com:8443
CSRF_TRUSTED_ORIGINS=

# Dev HTTPS reverse proxy (compose/dev-proxy.yml), serving NetBox at /netbox —
# the same path prod uses. Run ./scripts/dev-tls-cert.sh <hostname> first.
# DEV_HOSTNAME=netbox-dev.example.com
# DEV_PROXY_PORT=8443
# Set these to also simulate the prod Mellon SSO handoff; leave SSO_ENABLED
# false to log in with the local admin account instead.
# DEV_PROXY_SSO_ENABLED=false
# DEV_PROXY_SSO_USER=
# DEV_PROXY_SSO_EMAIL=
# DEV_PROXY_SSO_FIRST=
# DEV_PROXY_SSO_LAST=
# DEV_PROXY_SSO_GROUPS=netbox-admins|netops

# SUPERUSER_PASSWORD and the discovery secrets block are appended by
# scripts/init-dev-env.sh (dev only; fill DISCOVERY_* device creds by hand)
