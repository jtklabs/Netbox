# Copy to .env and adjust (scripts/init-dev-env.sh does this for you). Dev with discovery:
COMPOSE_FILE=docker-compose.yml:compose/dev.yml:compose/discovery.yml
# Dev core-only (no Diode/orb-agent):
# COMPOSE_FILE=docker-compose.yml:compose/dev.yml
# Prod (Gate 4+):
# COMPOSE_FILE=docker-compose.yml:compose/prod.yml
VERSION=v4.6.5-5.0.2
# SUPERUSER_PASSWORD and the discovery secrets block are appended by
# scripts/init-dev-env.sh (dev only; fill DISCOVERY_* device creds by hand)
